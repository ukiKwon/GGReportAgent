<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>2.7.18</version>
    <relativePath/>
  </parent>

  <groupId>com.kb</groupId>
  <artifactId>uploader</artifactId>
  <version>1.0.0</version>
  <packaging>war</packaging>

  <properties>
    <java.version>1.8</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <!-- Spring Data (Page/Pageable/PageImpl 등) — MyBatis와 함께 사용 -->
    <dependency>
      <groupId>org.springframework.data</groupId>
      <artifactId>spring-data-commons</artifactId>
    </dependency>
    <!-- MyBatis (u-kesa 대리 — 폐쇄망 반입 시 u-kesa 의존성으로 교체) -->
    <dependency>
      <groupId>org.mybatis.spring.boot</groupId>
      <artifactId>mybatis-spring-boot-starter</artifactId>
      <version>2.3.2</version>
    </dependency>

    <!-- MySQL 드라이버 (로컬 전용) -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- WebLogic 배포 시 내장 톰캣 제외 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-tomcat</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Oracle JDBC — Maven Central에서 다운로드 가능.
         DMZ 운영 환경에서는 내부 Nexus/Artifactory 미러 설정 필요 -->
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc8</artifactId>
      <version>21.7.0.0</version>
    </dependency>
    <!-- Apache PDFBox (PDF 텍스트 추출) -->
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>2.0.29</version>
    </dependency>
    <!-- Apache POI (XLSX) -->
    <!--
      commons-io 버전 고정 (2026-09-23).
      ⚠️ POI 5.2.3 은 IOUtils.byteArray(int) 를 부르는데 그 메서드는 commons-io 2.9 부터다.
         내부망에 옛 버전(2.6 등)이 먼저 잡히면 PPT 업로드에서
         NoSuchMethodError: org.apache.commons.io.IOUtils.byteArray(I)[B 가 난다(실제 발생).
         POI 가 명시한 값은 2.11.0 이지만 2.x 는 상위 호환이라 2.15.1 로 못박는다
         — 내부망에 이미 2.15 가 있어 그쪽과 맞추는 편이 낫다(전체 테스트 64건 통과 확인).
      ⚠️ WEB-INF/lib 에 옛 commons-io jar 가 함께 있으면 이 고정이 무의미하다. 하나만 남길 것.
    -->
    <dependency>
      <groupId>commons-io</groupId>
      <artifactId>commons-io</artifactId>
      <version>2.15.1</version>
    </dependency>

    <!-- ── 2026-09-23 파싱 전환으로 추가 (폐쇄망 반입 시 전이 의존까지 함께 반입할 것) ── -->
    <!-- .ppt(97-2003) 슬라이드 추출 -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-scratchpad</artifactId>
      <version>5.2.3</version>
    </dependency>
    <!-- HWP 본문·표 -->
    <dependency>
      <groupId>kr.dogfoot</groupId>
      <artifactId>hwplib</artifactId>
      <version>1.1.11</version>
    </dependency>
    <!-- HWPX 본문·표 -->
    <dependency>
      <groupId>kr.dogfoot</groupId>
      <artifactId>hwpxlib</artifactId>
      <version>1.0.9</version>
    </dependency>
    <!-- 한국어 형태소 분석 (TextRank 요약). lucene-core 8.11.4 가 전이 의존으로 따라온다 -->
    <dependency>
      <groupId>org.apache.lucene</groupId>
      <artifactId>lucene-analyzers-nori</artifactId>
      <version>8.11.4</version>
    </dependency>

    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>5.2.3</version>
    </dependency>
    <!-- Jackson (JSON import/export) -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- Thymeleaf Java 8 Time Support (#temporals) -->
    <dependency>
      <groupId>org.thymeleaf.extras</groupId>
      <artifactId>thymeleaf-extras-java8time</artifactId>
    </dependency>
    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- JUnit 4 API + Vintage Runner (Spring Boot 2.7.x 기본은 JUnit 5이므로 명시적 추가) -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.vintage</groupId>
      <artifactId>junit-vintage-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <!-- test: 단위 테스트용 / runtime: 로컬 실행 시 local 프로파일용 -->
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
