<?xml version="1.0" encoding="UTF-8"?>
<!--
  WebSphere Traditional 9.x 용 바인딩. weblogic.xml 과 공존한다 — WebLogic 은 이 파일을 무시하고,
  WebSphere 는 weblogic.xml 을 무시한다. 같은 WAR 을 양쪽에 올릴 수 있다.

  ⚠️ binding-name 은 WebSphere 관리 콘솔에 실제로 만든 JNDI 이름과 같아야 한다.
     아래 값은 web.xml 의 res-ref-name 과 맞춘 **플레이스홀더**다 — 인프라에 확인 후 바꿀 것.
     · DataSource  : 자원 > JDBC > 데이터 소스 의 JNDI 이름
     · TimerManager: 자원 > 타이머 > 타이머 관리자 의 JNDI 이름
     못 찾으면 앱은 뜨지만 LocalScheduler 로 떨어지고 WARN 을 남긴다(SchedulerConfig).
-->
<web-bnd
        xmlns="http://websphere.ibm.com/xml/ns/javaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://websphere.ibm.com/xml/ns/javaee
                            http://websphere.ibm.com/xml/ns/javaee/ibm-web-bnd_1_0.xsd"
        version="1.0">

  <resource-ref name="jdbc/uploaderDS" binding-name="jdbc/uploaderDS"/>
  <resource-ref name="timer/uploaderTM" binding-name="timer/uploaderTM"/>

</web-bnd>
