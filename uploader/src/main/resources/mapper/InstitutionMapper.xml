<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  ⚠️ **2026-09-08 — 테이블·컬럼 이름이 전부 바뀌었다** (사내 DB 표준: 컬럼은 한글,
     테이블은 코드). 자바 필드명(property)은 그대로다.

       INSTITUTION → **TSKGIAF02**         시퀀스 → TSKGIAF02_SEQ

       property    →  column
       id          →  기관ID
       name        →  기관명
       category    →  기관분류
       modifiedAt  →  수정일시
-->
<mapper namespace="com.kb.uploader.mapper.InstitutionMapper">

  <resultMap id="institutionMap" type="Institution">
    <id     property="id"         column="기관ID"/>
    <result property="name"       column="기관명"/>
    <result property="category"   column="기관분류"/>
    <result property="modifiedAt" column="수정일시"/>
  </resultMap>

  <!--
    ⚠️ 같은 id 가 두 번 나오는 자리는 **방언 분기**다(databaseId). 접속한 DB 에 맞는
       쪽만 로드된다 — config/MyBatisConfig 가 값을 정한다. **항상 둘을 같이 고칠 것.**
  -->

  <!-- MySQL -->
  <insert id="insert" databaseId="mysql" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO TSKGIAF02 (기관명, 기관분류, 수정일시)
    VALUES (#{name}, #{category}, #{modifiedAt})
  </insert>
  <!-- Oracle: 시퀀스에서 먼저 ID를 받아 직접 넣는다 (schema-oracle.sql 의 TSKGIAF02_SEQ) -->
  <insert id="insert" databaseId="oracle">
    <selectKey keyProperty="id" resultType="long" order="BEFORE">
      SELECT TSKGIAF02_SEQ.NEXTVAL FROM DUAL
    </selectKey>
    INSERT INTO TSKGIAF02 (기관ID, 기관명, 기관분류, 수정일시)
    VALUES (#{id}, #{name}, #{category}, #{modifiedAt})
  </insert>

  <update id="update">
    UPDATE TSKGIAF02
    SET 기관명 = #{name}, 기관분류 = #{category}, 수정일시 = #{modifiedAt}
    WHERE 기관ID = #{id}
  </update>

  <delete id="deleteById">
    DELETE FROM TSKGIAF02 WHERE 기관ID = #{id}
  </delete>

  <delete id="deleteAll">
    DELETE FROM TSKGIAF02
  </delete>

  <select id="findByName" resultMap="institutionMap">
    SELECT * FROM TSKGIAF02 WHERE 기관명 = #{name}
  </select>

  <select id="findAll" resultMap="institutionMap">
    SELECT * FROM TSKGIAF02 ORDER BY 기관명 ASC
  </select>

</mapper>
