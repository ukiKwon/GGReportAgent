<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  ⚠️ **2026-09-08 — 사내 DB 표준을 반영했다.** 자바 필드명(property)은 그대로다.

       INSTITUTION → TSKGIAF02          시퀀스 → SQ_KGI_AGENTGIGANTABLE

       property    →  컬럼명          인포타입
       id          →  기관일련번호     일련번호16 (DECIMAL)
       name        →  기관명          명40
       category    →  기관영업분류구분  코드2       ★ TypeHandler
       modifiedAt  →  시스템사용일시   일시14      ★ TypeHandler (옛 수정일시)
       systemUserNo →  시스템사용자번호 사용자번호7

  ★ TypeHandler 를 resultMap 과 `#{...}` **양쪽에** 적어야 한다. 한쪽만 적으면
    읽기나 쓰기 중 한 방향만 변환돼 조용히 어긋난다. 이유는 UploadedFileMapper 주석.
-->
<mapper namespace="com.kb.uploader.mapper.InstitutionMapper">

  <resultMap id="institutionMap" type="Institution">
    <id     property="id"         column="기관일련번호"/>
    <result property="name"       column="기관명"/>
    <result property="category"   column="기관영업분류구분"
            typeHandler="com.kb.uploader.config.InstitutionCategoryTypeHandler"/>
    <result property="modifiedAt" column="시스템사용일시"
            typeHandler="com.kb.uploader.config.LocalDateTimeStringTypeHandler"/>
    <!-- ⚠️ UploadedFileMapper 의 같은 자리와 같은 이유다(2026-09-09) — 읽기 누락. -->
    <result property="systemUserNo" column="시스템사용자번호"/>
  </resultMap>

  <sql id="값목록">
    #{name},
    #{category,typeHandler=com.kb.uploader.config.InstitutionCategoryTypeHandler},
    #{modifiedAt,typeHandler=com.kb.uploader.config.LocalDateTimeStringTypeHandler}
  </sql>

  <!--
    ⚠️ 같은 id 가 두 번 나오는 자리는 **방언 분기**다(databaseId). 접속한 DB 에 맞는
       쪽만 로드된다 — config/MyBatisConfig 가 값을 정한다. **항상 둘을 같이 고칠 것.**
  -->

  <!-- MySQL -->
  <insert id="insert" databaseId="mysql" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO TSKGIAF02 (기관명, 기관영업분류구분, 시스템사용일시, 시스템사용자번호)
    VALUES (<include refid="값목록"/>, #{systemUserNo})
  </insert>
  <!-- Oracle: 시퀀스에서 먼저 ID를 받아 직접 넣는다 (schema-oracle.sql 의 SQ_KGI_AGENTGIGANTABLE) -->
  <insert id="insert" databaseId="oracle">
    <selectKey keyProperty="id" resultType="long" order="BEFORE">
      SELECT SQ_KGI_AGENTGIGANTABLE.NEXTVAL FROM DUAL
    </selectKey>
    INSERT INTO TSKGIAF02 (기관일련번호, 기관명, 기관영업분류구분, 시스템사용일시, 시스템사용자번호)
    VALUES (#{id}, <include refid="값목록"/>, #{systemUserNo})
  </insert>

  <update id="update">
    UPDATE TSKGIAF02
    SET 기관명   = #{name},
        기관영업분류구분 = #{category,typeHandler=com.kb.uploader.config.InstitutionCategoryTypeHandler},
        시스템사용일시   = #{modifiedAt,typeHandler=com.kb.uploader.config.LocalDateTimeStringTypeHandler},
        시스템사용자번호 = #{systemUserNo}
    WHERE 기관일련번호 = #{id}
  </update>

  <delete id="deleteById">
    DELETE FROM TSKGIAF02 WHERE 기관일련번호 = #{id}
  </delete>

  <delete id="deleteAll">
    DELETE FROM TSKGIAF02
  </delete>

  <!--
    ⚠️ **이 앱에서 가장 중요한 문장이다.** 업로드된 파일의 기관명으로 여기를 조회해
       못 찾으면 파일이 UNCLASSIFIED 로 남는다(ClassificationService.classify).
       틀리면 오류 없이 "분류가 하나도 안 되는" 증상으로만 나타난다.
  -->
  <select id="findByName" resultMap="institutionMap">
    SELECT * FROM TSKGIAF02 WHERE 기관명 = #{name}
  </select>

  <select id="findAll" resultMap="institutionMap">
    SELECT * FROM TSKGIAF02 ORDER BY 기관명 ASC
  </select>

</mapper>
