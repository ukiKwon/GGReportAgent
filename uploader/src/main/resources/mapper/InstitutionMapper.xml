<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  ⚠️ **2026-09-08 에 컬럼명이 전부 바뀌었다.** 자바 필드명(property)은 그대로다.

       property    →  column
       id          →  INSTITUTION_ID
       name        →  INSTITUTION_NAME
       category    →  INSTITUTION_CATEGORY
       modifiedAt  →  MODIFIED_AT
-->
<mapper namespace="com.kb.uploader.mapper.InstitutionMapper">

  <resultMap id="institutionMap" type="Institution">
    <id     property="id"         column="INSTITUTION_ID"/>
    <result property="name"       column="INSTITUTION_NAME"/>
    <result property="category"   column="INSTITUTION_CATEGORY"/>
    <result property="modifiedAt" column="MODIFIED_AT"/>
  </resultMap>

  <!--
    ⚠️ 같은 id 가 두 번 나오는 자리는 **방언 분기**다(databaseId). 접속한 DB 에 맞는
       쪽만 로드된다 — config/MyBatisConfig 가 값을 정한다. **항상 둘을 같이 고칠 것.**
  -->

  <!-- MySQL -->
  <insert id="insert" databaseId="mysql" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO INSTITUTION (INSTITUTION_NAME, INSTITUTION_CATEGORY, MODIFIED_AT)
    VALUES (#{name}, #{category}, #{modifiedAt})
  </insert>
  <!-- Oracle: 시퀀스에서 먼저 ID를 받아 직접 넣는다 (schema-oracle.sql 의 INSTITUTION_SEQ) -->
  <insert id="insert" databaseId="oracle">
    <selectKey keyProperty="id" resultType="long" order="BEFORE">
      SELECT INSTITUTION_SEQ.NEXTVAL FROM DUAL
    </selectKey>
    INSERT INTO INSTITUTION (INSTITUTION_ID, INSTITUTION_NAME, INSTITUTION_CATEGORY, MODIFIED_AT)
    VALUES (#{id}, #{name}, #{category}, #{modifiedAt})
  </insert>

  <update id="update">
    UPDATE INSTITUTION
    SET INSTITUTION_NAME = #{name}, INSTITUTION_CATEGORY = #{category}, MODIFIED_AT = #{modifiedAt}
    WHERE INSTITUTION_ID = #{id}
  </update>

  <delete id="deleteById">
    DELETE FROM INSTITUTION WHERE INSTITUTION_ID = #{id}
  </delete>

  <delete id="deleteAll">
    DELETE FROM INSTITUTION
  </delete>

  <select id="findByName" resultMap="institutionMap">
    SELECT * FROM INSTITUTION WHERE INSTITUTION_NAME = #{name}
  </select>

  <select id="findAll" resultMap="institutionMap">
    SELECT * FROM INSTITUTION ORDER BY INSTITUTION_NAME ASC
  </select>

</mapper>
