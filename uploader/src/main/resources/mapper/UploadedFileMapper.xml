<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  ⚠️ **2026-09-08 — 사내 DB 표준을 반영했다.** 테이블은 코드, 컬럼은 한글, 그리고
     타입은 인포타입이 정한다. 자바 필드명(property)은 그대로다.

       UPLOADED_FILE → TSKGIAF01        시퀀스 → TSKGIAF01_SEQ

       property        →  컬럼명                 인포타입
       id              →  업로드파일일련번호      일련번호16 (DECIMAL)
       institutionName →  기관명                 명250
       category        →  기관구분               구분코드2   ★ TypeHandler
       year            →  문서년                 년4
       status          →  분류상태구분            구분코드2   ★ TypeHandler
       originalName    →  원본파일명              명260
       uploadedAt      →  업로드일시              일시20      ★ TypeHandler
       classifiedAt    →  분류일시                일시20      ★ TypeHandler
       storedPath      →  저장경로               내용800

  ★ **TypeHandler 를 자리마다 명시한다.** 두 코드 핸들러가 모두 자바 `String` 을
    다뤄서 자동 등록(type-handlers-package)을 쓸 수 없다 — 같은 타입에 둘이 걸리면
    어느 쪽이 잡힐지 알 수 없다. 그래서 resultMap 과 `#{...}` 양쪽에 적는다.
    **한쪽만 적으면 읽기나 쓰기 중 한 방향만 변환돼 조용히 어긋난다.**

  ⚠️ **SQL 문장에 직접 박힌 값은 TypeHandler 를 타지 않는다.** 아래
    `분류상태구분 = '04'` 처럼 **코드로 적어야 한다**. 거기에 'DELETED' 를 적으면
    오류 없이 0건이 바뀐다. 코드표는 `code/ClassificationStatus.java` 에 있다.
-->
<mapper namespace="com.kb.uploader.mapper.UploadedFileMapper">

  <resultMap id="uploadedFileMap" type="UploadedFile">
    <id     property="id"              column="업로드파일일련번호"/>
    <result property="institutionName" column="기관명"/>
    <result property="category"        column="기관구분"
            typeHandler="com.kb.uploader.config.InstitutionCategoryTypeHandler"/>
    <result property="year"            column="문서년"/>
    <result property="status"          column="분류상태구분"
            typeHandler="com.kb.uploader.config.ClassificationStatusTypeHandler"/>
    <result property="originalName"    column="원본파일명"/>
    <result property="uploadedAt"      column="업로드일시"
            typeHandler="com.kb.uploader.config.LocalDateTimeStringTypeHandler"/>
    <result property="classifiedAt"    column="분류일시"
            typeHandler="com.kb.uploader.config.LocalDateTimeStringTypeHandler"/>
    <result property="storedPath"      column="저장경로"/>
  </resultMap>

  <!-- 파라미터 쪽 TypeHandler 표기가 길어 sql 조각으로 묶는다 -->
  <sql id="값목록">
    #{institutionName},
    #{category,typeHandler=com.kb.uploader.config.InstitutionCategoryTypeHandler},
    #{year},
    #{status,typeHandler=com.kb.uploader.config.ClassificationStatusTypeHandler},
    #{originalName},
    #{uploadedAt,typeHandler=com.kb.uploader.config.LocalDateTimeStringTypeHandler},
    #{storedPath}
  </sql>

  <!--
    ⚠️ 같은 id 가 두 번 나오는 자리는 **방언 분기**다(databaseId). 접속한 DB 에 맞는
       쪽만 로드된다 — config/MyBatisConfig 가 값을 정한다.
       한쪽만 고치면 다른 DB 에서 조용히 낡는다. **항상 둘을 같이 고칠 것.**
  -->

  <!-- MySQL: useGeneratedKeys로 AUTO_INCREMENT id 채움 -->
  <insert id="insert" databaseId="mysql" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO TSKGIAF01
      (기관명, 기관구분, 문서년, 분류상태구분, 원본파일명, 업로드일시, 저장경로)
    VALUES
      (<include refid="값목록"/>)
  </insert>
  <!-- Oracle: 시퀀스에서 먼저 ID를 받아 직접 넣는다 (schema-oracle.sql 의 TSKGIAF01_SEQ) -->
  <insert id="insert" databaseId="oracle">
    <selectKey keyProperty="id" resultType="long" order="BEFORE">
      SELECT TSKGIAF01_SEQ.NEXTVAL FROM DUAL
    </selectKey>
    INSERT INTO TSKGIAF01
      (업로드파일일련번호, 기관명, 기관구분, 문서년, 분류상태구분, 원본파일명, 업로드일시, 저장경로)
    VALUES
      (#{id}, <include refid="값목록"/>)
  </insert>

  <update id="update">
    UPDATE TSKGIAF01
    SET
    저장경로      = #{storedPath},
    기관명        = #{institutionName},
    문서년        = #{year},
    기관구분      = #{category,typeHandler=com.kb.uploader.config.InstitutionCategoryTypeHandler},
    분류상태구분  = #{status,typeHandler=com.kb.uploader.config.ClassificationStatusTypeHandler},
    분류일시      = #{classifiedAt,typeHandler=com.kb.uploader.config.LocalDateTimeStringTypeHandler}
    WHERE 업로드파일일련번호 = #{id}
  </update>

  <!-- ⚠️ '04' = DELETED, '03' = REJECTED, '02' = CLASSIFIED (code/ClassificationStatus.java) -->
  <update id="softDeleteById">
    UPDATE TSKGIAF01 SET 분류상태구분 = '04' WHERE 업로드파일일련번호 = #{id}
  </update>

  <update id="rejectById">
    UPDATE TSKGIAF01 SET 분류상태구분 = '03' WHERE 업로드파일일련번호 = #{id}
  </update>

  <select id="findById" resultMap="uploadedFileMap">
    SELECT * FROM TSKGIAF01 WHERE 업로드파일일련번호 = #{id}
  </select>

  <select id="findByStatus" resultMap="uploadedFileMap">
    SELECT * FROM TSKGIAF01
    WHERE 분류상태구분 = #{status,typeHandler=com.kb.uploader.config.ClassificationStatusTypeHandler}
  </select>

  <select id="findClassifiedByUnknownInstitution" resultMap="uploadedFileMap">
    SELECT * FROM TSKGIAF01
    WHERE 기관명 = '알수없음' AND 분류상태구분 = '02'
    ORDER BY 업로드일시 DESC
  </select>

  <select id="countAll" resultType="long">
    SELECT COUNT(*) FROM TSKGIAF01
  </select>

  <select id="countByStatus" resultType="long">
    SELECT COUNT(*) FROM TSKGIAF01
    WHERE 분류상태구분 = #{status,typeHandler=com.kb.uploader.config.ClassificationStatusTypeHandler}
  </select>

  <!--
    ⚠️ 업로드일시가 문자열(YYYYMMDDHH24MISS)이라 아래 정렬은 **문자열 정렬**이다.
       자릿수가 고정이라 사전순 = 시간순이 맞다. 형식을 바꾸면 이 성질이 깨진다.
  -->
  <!-- MySQL: LIMIT -->
  <select id="findRecent" databaseId="mysql" resultMap="uploadedFileMap">
    SELECT * FROM TSKGIAF01 ORDER BY 업로드일시 DESC LIMIT #{limit}
  </select>
  <!-- Oracle: ROWNUM 은 ORDER BY 보다 먼저 매겨지므로 정렬을 인라인 뷰로 감싼다 -->
  <select id="findRecent" databaseId="oracle" resultMap="uploadedFileMap">
    SELECT * FROM (
      SELECT * FROM TSKGIAF01 ORDER BY 업로드일시 DESC
    ) WHERE ROWNUM &lt;= #{limit}
  </select>

  <!-- MySQL: LIMIT ... OFFSET -->
  <select id="findByInstitutionNameContaining" databaseId="mysql" resultMap="uploadedFileMap">
    SELECT * FROM TSKGIAF01
    WHERE 기관명 LIKE CONCAT('%', #{keyword}, '%')
    ORDER BY 업로드일시 DESC
    LIMIT #{limit} OFFSET #{offset}
  </select>
  <!-- Oracle: ROWNUM 2단 중첩 페이징. 안쪽에서 상한, 바깥에서 하한을 건다 -->
  <select id="findByInstitutionNameContaining" databaseId="oracle" resultMap="uploadedFileMap">
    SELECT * FROM (
      SELECT a.*, ROWNUM RN FROM (
        SELECT * FROM TSKGIAF01
        WHERE 기관명 LIKE '%' || #{keyword} || '%'
        ORDER BY 업로드일시 DESC
      ) a WHERE ROWNUM &lt;= #{offset} + #{limit}
    ) WHERE RN &gt; #{offset}
  </select>

  <!-- MySQL: CONCAT -->
  <select id="countByInstitutionNameContaining" databaseId="mysql" resultType="long">
    SELECT COUNT(*) FROM TSKGIAF01
    WHERE 기관명 LIKE CONCAT('%', #{keyword}, '%')
  </select>
  <!-- Oracle: || 로 연결 -->
  <select id="countByInstitutionNameContaining" databaseId="oracle" resultType="long">
    SELECT COUNT(*) FROM TSKGIAF01
    WHERE 기관명 LIKE '%' || #{keyword} || '%'
  </select>

  <!-- MySQL: 다중 조건 검색 -->
  <select id="search" databaseId="mysql" resultMap="uploadedFileMap">
    SELECT * FROM TSKGIAF01
    WHERE
    (#{institution} = '' OR 기관명 LIKE CONCAT('%', #{institution}, '%'))
    AND (#{year} = '' OR 문서년 = #{year})
    AND (#{keyword} = '' OR 원본파일명 LIKE CONCAT('%', #{keyword}, '%'))
    ORDER BY 업로드일시 DESC
  </select>
  <!--
    Oracle: || 로 연결.
    ⚠️ Oracle 은 빈 문자열을 NULL 로 바꾸므로 `#{x} = ''` 는 **항상 거짓**이다.
       "빈 값이면 조건을 걸지 않는다"는 원래 뜻을 살리려면 NULL 검사여야 한다.
       (MySQL 쪽은 ''를 값으로 담으므로 `= ''` 가 맞다 — 그래서 문장이 갈린다.)
  -->
  <select id="search" databaseId="oracle" resultMap="uploadedFileMap">
    SELECT * FROM TSKGIAF01
    WHERE
      (#{institution} IS NULL OR 기관명 LIKE '%' || #{institution} || '%')
      AND (#{year} IS NULL OR 문서년 = #{year})
      AND (#{keyword} IS NULL OR 원본파일명 LIKE '%' || #{keyword} || '%')
    ORDER BY 업로드일시 DESC
  </select>

</mapper>
