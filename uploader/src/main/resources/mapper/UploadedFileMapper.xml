<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  ⚠️ **2026-09-08 — 사내 DB 표준을 반영했다.** 테이블은 코드, 컬럼은 한글, 그리고
     타입은 인포타입이 정한다. 자바 필드명(property)은 그대로다.

       UPLOADED_FILE → TSKGIAF01        시퀀스 → SQ_KGI_AGENTFILETABLE

       property        →  컬럼명                 인포타입
       id              →  업로드파일일련번호      일련번호16 (DECIMAL)
       institutionName →  기관명                 명40
       category        →  기관영업분류구분        코드2       ★ TypeHandler
       year            →  문서년                 년4
       status          →  분류상태구분            구분코드2   ★ TypeHandler
       originalName    →  원본파일명              명260
       uploadedAt      →  업로드일시              일시14      ★ TypeHandler
       classifiedAt    →  분류일시                일시14      ★ TypeHandler
       storedPath      →  저장경로내용            내용600
       systemUsedAt    →  시스템사용일시           일시14   ★ TypeHandler
       systemUserNo    →  시스템사용자번호         사용자번호7

  ★ **TypeHandler 를 자리마다 명시한다.** 두 코드 핸들러가 모두 자바 `String` 을
    다뤄서 자동 등록(type-handlers-package)을 쓸 수 없다 — 같은 타입에 둘이 걸리면
    어느 쪽이 잡힐지 알 수 없다. 그래서 resultMap 과 `#{...}` 양쪽에 적는다.
    **한쪽만 적으면 읽기나 쓰기 중 한 방향만 변환돼 조용히 어긋난다.**

  ⚠️ **SQL 문장에 직접 박힌 값은 TypeHandler 를 타지 않는다.** 아래
    `분류상태구분 = '04'` 처럼 **코드로 적어야 한다**. 거기에 'DELETED' 를 적으면
    오류 없이 0건이 바뀐다. 코드표는 `code/ClassificationStatus.java` 에 있다.
-->
<mapper namespace="com.kb.uploader.mapper.UploadedFileMapper">

  <resultMap id="uploadedFileMap" type="UploadedFile">
    <id     property="id"              column="업로드파일일련번호"/>
    <result property="institutionName" column="기관명"/>
    <result property="category"        column="기관영업분류구분"
            typeHandler="com.kb.uploader.config.InstitutionCategoryTypeHandler"/>
    <result property="year"            column="문서년"/>
    <result property="status"          column="분류상태구분"
            typeHandler="com.kb.uploader.config.ClassificationStatusTypeHandler"/>
    <result property="originalName"    column="원본파일명"/>
    <result property="uploadedAt"      column="업로드일시"
            typeHandler="com.kb.uploader.config.LocalDateTimeStringTypeHandler"/>
    <result property="classifiedAt"    column="분류일시"
            typeHandler="com.kb.uploader.config.LocalDateTimeStringTypeHandler"/>
    <result property="storedPath"      column="저장경로내용"/>
    <!--
      ⚠️ 감사 2열은 **읽기에도 반드시 있어야 한다**(2026-09-09 추가). 종전에는 쓰기
         (`#{...}`)만 있고 여기가 빠져 있어 DB 에는 값이 들어가는데 조회하면 늘
         null 이었다 — 화면이 비어 보이는 게 첫 증상이다. 더 나쁜 건
         KGI12100$FileStatusClassify 처럼 **findById 로 읽어 그대로 update 하는 경로**
         에서 그 null 이 DB 로 되써진다는 점이다.
    -->
    <result property="systemUsedAt"    column="시스템사용일시"
            typeHandler="com.kb.uploader.config.LocalDateTimeStringTypeHandler"/>
    <result property="systemUserNo"    column="시스템사용자번호"/>
  </resultMap>

  <!-- 파라미터 쪽 TypeHandler 표기가 길어 sql 조각으로 묶는다 -->
  <sql id="값목록">
    #{institutionName},
    <include refid="기관분류값"/>,
    #{year},
    #{status,typeHandler=com.kb.uploader.config.ClassificationStatusTypeHandler},
    #{originalName},
    #{uploadedAt,typeHandler=com.kb.uploader.config.LocalDateTimeStringTypeHandler},
    #{storedPath}
  </sql>

  <!--
    ⚠️ 파싱 전환(2026-09-23) 이후 기관분류가 **"미분류"** 일 수 있다. 그 값은
       code/InstitutionCategory 의 코드표(01~05)에 없어서 TypeHandler 가 예외를 던진다.
       DDL 의 CHECK 제약도 코드 5종만 받는다. 그래서 **미분류는 NULL 로 저장**한다.
       화면 표기는 UploadedFile.getCategoryLabel() 이 NULL 을 "미분류" 로 되돌린다.
  -->
  <sql id="기관분류값">
    <choose>
      <when test="category == null or category == '미분류'">NULL</when>
      <otherwise>#{category,typeHandler=com.kb.uploader.config.InstitutionCategoryTypeHandler}</otherwise>
    </choose>
  </sql>

  <!--
    ⚠️ 같은 id 가 두 번 나오는 자리는 **방언 분기**다(databaseId). 접속한 DB 에 맞는
       쪽만 로드된다 — config/MyBatisConfig 가 값을 정한다.
       한쪽만 고치면 다른 DB 에서 조용히 낡는다. **항상 둘을 같이 고칠 것.**
  -->

  <!-- MySQL: useGeneratedKeys로 AUTO_INCREMENT id 채움 -->
  <insert id="insert" databaseId="mysql" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO TSKGIAF01
      (기관명, 기관영업분류구분, 문서년, 분류상태구분, 원본파일명, 업로드일시, 저장경로내용,
       시스템사용일시, 시스템사용자번호)
    VALUES
      (<include refid="값목록"/>,
       #{systemUsedAt,typeHandler=com.kb.uploader.config.LocalDateTimeStringTypeHandler}, #{systemUserNo})
  </insert>
  <!-- Oracle: 시퀀스에서 먼저 ID를 받아 직접 넣는다 (schema-oracle.sql 의 SQ_KGI_AGENTFILETABLE) -->
  <insert id="insert" databaseId="oracle">
    <selectKey keyProperty="id" resultType="long" order="BEFORE">
      SELECT SQ_KGI_AGENTFILETABLE.NEXTVAL FROM DUAL
    </selectKey>
    INSERT INTO TSKGIAF01
      (업로드파일일련번호, 기관명, 기관영업분류구분, 문서년, 분류상태구분, 원본파일명, 업로드일시,
       저장경로내용, 시스템사용일시, 시스템사용자번호)
    VALUES
      (#{id}, <include refid="값목록"/>,
       #{systemUsedAt,typeHandler=com.kb.uploader.config.LocalDateTimeStringTypeHandler}, #{systemUserNo})
  </insert>

  <update id="update">
    UPDATE TSKGIAF01
    SET
    저장경로내용      = #{storedPath},
    기관명        = #{institutionName},
    문서년        = #{year},
    기관영업분류구분      = <include refid="기관분류값"/>,
    분류상태구분  = #{status,typeHandler=com.kb.uploader.config.ClassificationStatusTypeHandler},
    분류일시      = #{classifiedAt,typeHandler=com.kb.uploader.config.LocalDateTimeStringTypeHandler},
    시스템사용일시   = #{systemUsedAt,typeHandler=com.kb.uploader.config.LocalDateTimeStringTypeHandler},
    시스템사용자번호 = #{systemUserNo}
    WHERE 업로드파일일련번호 = #{id}
  </update>

  <!--
    파싱 결과 기록 (2026-09-23 신설, 스키마 무변경안).
    ⚠️ 새 컬럼이 없으므로 **기존 컬럼에 태운다**:
       저장경로내용 = 산출물 경로(성공) 또는 원본 경로(실패) · 분류일시 = 파싱 시각 ·
       문서년 = 제안서 연도. 실패 사유는 넣을 자리가 없어 로그에만 남는다.
  -->
  <update id="updateParseResult">
    UPDATE TSKGIAF01
    SET
    저장경로내용     = #{storedPath},
    기관명           = #{institutionName},
    문서년           = #{year},
    기관영업분류구분 = <include refid="기관분류값"/>,
    분류상태구분     = #{status,typeHandler=com.kb.uploader.config.ClassificationStatusTypeHandler},
    분류일시         = #{classifiedAt,typeHandler=com.kb.uploader.config.LocalDateTimeStringTypeHandler},
    시스템사용일시   = #{systemUsedAt,typeHandler=com.kb.uploader.config.LocalDateTimeStringTypeHandler},
    시스템사용자번호 = #{systemUserNo}
    WHERE 업로드파일일련번호 = #{id}
  </update>

  <!--
    ⚠️ '04' = DELETED, '03' = REJECTED, '02' = CLASSIFIED (code/ClassificationStatus.java)
    ⚠️ 이 둘은 파라미터에 시각 값이 없어 **컨트롤러가 LocalDateTime.now() 를 넘긴다.**
       DB 함수(TO_CHAR(SYSDATE)/DATE_FORMAT(NOW()))를 쓰면 방언이 갈리고 테스트로
       확인하기도 어려워, 자바에서 정해 넘기는 쪽을 택했다.
  -->
  <update id="softDeleteById">
    UPDATE TSKGIAF01 SET 분류상태구분 = '04',
      시스템사용일시 = #{systemUsedAt,typeHandler=com.kb.uploader.config.LocalDateTimeStringTypeHandler}, 시스템사용자번호 = #{systemUserNo}
    WHERE 업로드파일일련번호 = #{id}
  </update>

  <update id="rejectById">
    UPDATE TSKGIAF01 SET 분류상태구분 = '03',
      시스템사용일시 = #{systemUsedAt,typeHandler=com.kb.uploader.config.LocalDateTimeStringTypeHandler}, 시스템사용자번호 = #{systemUserNo}
    WHERE 업로드파일일련번호 = #{id}
  </update>

  <select id="findById" resultMap="uploadedFileMap">
    SELECT * FROM TSKGIAF01 WHERE 업로드파일일련번호 = #{id}
  </select>

  <!--
    ⚠️ **종전에는 ORDER BY 가 없었다**(2026-09-08 추가). 목록 순서를 DB 에 맡긴 셈이라
       화면이 대체로 삽입순처럼 보였을 뿐 보장된 것이 아니었고, 인덱스가 붙는 순간
       순서가 바뀐다. 정렬 컬럼을 PK 로 둔 이유는 findRecent 와 같다(같은 초 문제).
       인덱스 (분류상태구분, 업로드파일일련번호) 가 **필터와 정렬을 함께** 받는다.
  -->
  <select id="findByStatus" resultMap="uploadedFileMap">
    SELECT * FROM TSKGIAF01
    WHERE 분류상태구분 = #{status,typeHandler=com.kb.uploader.config.ClassificationStatusTypeHandler}
    ORDER BY 업로드파일일련번호 DESC
  </select>

  <select id="findClassifiedByUnknownInstitution" resultMap="uploadedFileMap">
    SELECT * FROM TSKGIAF01
    WHERE 기관명 = '알수없음' AND 분류상태구분 = '02'
    ORDER BY 업로드일시 DESC
  </select>

  <select id="countAll" resultType="long">
    SELECT COUNT(*) FROM TSKGIAF01
  </select>

  <select id="countByStatus" resultType="long">
    SELECT COUNT(*) FROM TSKGIAF01
    WHERE 분류상태구분 = #{status,typeHandler=com.kb.uploader.config.ClassificationStatusTypeHandler}
  </select>

  <!--
    ⚠️ **최신순 정렬을 업로드일시가 아니라 PK 로 한다**(2026-09-08).
       ⓐ 시퀀스가 NOCACHE 라 증가순 = 삽입순 = 시간순이고,
       ⓑ 업로드일시는 문자열 초 단위라 **같은 초에 여러 건이면 순서가 뒤섞인다**,
       ⓒ **PK 인덱스가 정렬을 그대로 처리**해 (업로드일시) 인덱스가 필요 없어진다.
       ⚠️ 시퀀스에 캐시를 켜면 ⓐ 가 깨진다 — 그때는 이 정렬을 다시 봐야 한다.
  -->
  <!-- MySQL: LIMIT -->
  <select id="findRecent" databaseId="mysql" resultMap="uploadedFileMap">
    SELECT * FROM TSKGIAF01 ORDER BY 업로드파일일련번호 DESC LIMIT #{limit}
  </select>

  <!-- Oracle: ROWNUM 은 ORDER BY 보다 먼저 매겨지므로 정렬을 인라인 뷰로 감싼다 -->
  <select id="findRecent" databaseId="oracle" resultMap="uploadedFileMap">
    SELECT * FROM (
      SELECT * FROM TSKGIAF01 ORDER BY 업로드파일일련번호 DESC
    ) WHERE ROWNUM &lt;= #{limit}
  </select>

  <!--
    ⚠️ 아래 세 문장(기관명 검색·검색)은 **업로드일시로 정렬한다** — findRecent 와 다르다.
       인덱스 (기관명, 업로드일시) 의 두 번째 열이 업로드일시라, 기관명이 정확 일치가
       되는 날 **정렬까지 인덱스가 처리**하게 하려는 것이다. 여기를 일련번호로 바꾸면
       그 이점이 사라진다.
       업로드일시가 문자열(YYYYMMDDHH24MISS)이라 문자열 정렬이지만, 자릿수가 고정이라
       사전순 = 시간순이 맞다. 형식을 바꾸면 이 성질이 깨진다.
  -->
  <!-- MySQL: LIMIT ... OFFSET -->
  <select id="findByInstitutionNameContaining" databaseId="mysql" resultMap="uploadedFileMap">
    SELECT * FROM TSKGIAF01
    WHERE 기관명 LIKE CONCAT('%', #{keyword}, '%')
    ORDER BY 업로드일시 DESC
    LIMIT #{limit} OFFSET #{offset}
  </select>

  <!-- Oracle: ROWNUM 2단 중첩 페이징. 안쪽에서 상한, 바깥에서 하한을 건다 -->
  <select id="findByInstitutionNameContaining" databaseId="oracle" resultMap="uploadedFileMap">
    SELECT * FROM (
      SELECT a.*, ROWNUM RN FROM (
        SELECT * FROM TSKGIAF01
        WHERE 기관명 LIKE '%' || #{keyword} || '%'
        ORDER BY 업로드일시 DESC
      ) a WHERE ROWNUM &lt;= #{offset} + #{limit}
    ) WHERE RN &gt; #{offset}
  </select>

  <!-- MySQL: CONCAT -->
  <select id="countByInstitutionNameContaining" databaseId="mysql" resultType="long">
    SELECT COUNT(*) FROM TSKGIAF01
    WHERE 기관명 LIKE CONCAT('%', #{keyword}, '%')
  </select>

  <!-- Oracle: || 로 연결 -->
  <select id="countByInstitutionNameContaining" databaseId="oracle" resultType="long">
    SELECT COUNT(*) FROM TSKGIAF01
    WHERE 기관명 LIKE '%' || #{keyword} || '%'
  </select>

  <!-- MySQL: 다중 조건 검색 -->
  <select id="search" databaseId="mysql" resultMap="uploadedFileMap">
    SELECT * FROM TSKGIAF01
    WHERE
    (#{institution} = '' OR 기관명 LIKE CONCAT('%', #{institution}, '%'))
    AND (#{year} = '' OR 문서년 = #{year})
    AND (#{keyword} = '' OR 원본파일명 LIKE CONCAT('%', #{keyword}, '%'))
    ORDER BY 업로드일시 DESC
  </select>

  <!--
    Oracle: || 로 연결.
    ⚠️ Oracle 은 빈 문자열을 NULL 로 바꾸므로 `#{x} = ''` 는 **항상 거짓**이다.
       "빈 값이면 조건을 걸지 않는다"는 원래 뜻을 살리려면 NULL 검사여야 한다.
       (MySQL 쪽은 ''를 값으로 담으므로 `= ''` 가 맞다 — 그래서 문장이 갈린다.)
  -->
  <select id="search" databaseId="oracle" resultMap="uploadedFileMap">
    SELECT * FROM TSKGIAF01
    WHERE
      (#{institution} IS NULL OR 기관명 LIKE '%' || #{institution} || '%')
      AND (#{year} IS NULL OR 문서년 = #{year})
      AND (#{keyword} IS NULL OR 원본파일명 LIKE '%' || #{keyword} || '%')
    ORDER BY 업로드일시 DESC
  </select>

  <!-- ══ 파싱 현황·대시보드·조회 API (2026-09-23, 스키마 무변경안) ══════════
       ⚠️ 컬럼을 늘리지 않았으므로 **파일명 규칙으로 판별**한다. 규칙 정본은
          code/DocumentType (ofFileName · isOutputPath) 이고, 아래 조각이 그 SQL 판이다.
          한쪽을 고치면 반드시 다른 쪽도 고칠 것 — 어긋나면 화면 숫자와 목록이 따로 논다.
            · 파싱 성공  = 저장경로내용이 .json 또는 .md   (= 산출물이 만들어졌다)
            · 파싱 실패  = 그 밖 (저장경로가 원본 그대로다)
            · 제안서     = 원본파일명이 .ppt / .pptx
            · RFP        = 원본파일명이 .pdf / .hwp / .hwpx
       ⚠️ 삭제(04)·반려(03) 건은 파싱 집계에서 뺀다. 사람이 처리를 끝낸 행이다.
  -->
  <sql id="파싱성공">(저장경로내용 LIKE '%.json' OR 저장경로내용 LIKE '%.md')</sql>
  <sql id="제안서원본">(원본파일명 LIKE '%.ppt' OR 원본파일명 LIKE '%.pptx')</sql>
  <sql id="RFP원본">(원본파일명 LIKE '%.pdf' OR 원본파일명 LIKE '%.hwp' OR 원본파일명 LIKE '%.hwpx')</sql>
  <sql id="파싱대상">(<include refid="제안서원본"/> OR <include refid="RFP원본"/>)</sql>
  <sql id="처리중">분류상태구분 NOT IN ('03', '04')</sql>

  <select id="countParseSuccess" resultType="long">
    SELECT COUNT(*) FROM TSKGIAF01
     WHERE <include refid="처리중"/> AND <include refid="파싱성공"/>
  </select>

  <select id="countParseFailed" resultType="long">
    SELECT COUNT(*) FROM TSKGIAF01
     WHERE <include refid="처리중"/> AND <include refid="파싱대상"/> AND NOT <include refid="파싱성공"/>
  </select>

  <select id="countProposalDocs" resultType="long">
    SELECT COUNT(*) FROM TSKGIAF01 WHERE <include refid="처리중"/> AND <include refid="제안서원본"/>
  </select>

  <select id="countRfpDocs" resultType="long">
    SELECT COUNT(*) FROM TSKGIAF01 WHERE <include refid="처리중"/> AND <include refid="RFP원본"/>
  </select>

  <!-- 파싱은 됐는데 기관을 못 찾은 건. 기관분류 NULL 이 곧 "미분류" 다 -->
  <select id="countParsedUnclassified" resultType="long">
    SELECT COUNT(*) FROM TSKGIAF01
     WHERE <include refid="처리중"/> AND <include refid="파싱성공"/> AND 기관영업분류구분 IS NULL
  </select>

  <select id="searchParseStatus" resultMap="uploadedFileMap">
    SELECT * FROM TSKGIAF01
     WHERE <include refid="처리중"/>
    <if test="docType == 'BID_PROPOSAL'">AND <include refid="제안서원본"/></if>
    <if test="docType == 'RFP'">AND <include refid="RFP원본"/></if>
    <if test="parseStatus == 'SUCCESS'">AND <include refid="파싱성공"/></if>
    <if test="parseStatus == 'FAILED'">AND <include refid="파싱대상"/> AND NOT <include refid="파싱성공"/></if>
    <if test="unclassifiedOnly != null and unclassifiedOnly">AND 기관영업분류구분 IS NULL</if>
     ORDER BY 업로드파일일련번호 DESC
  </select>

  <!-- ── 조회 API. 파싱 성공한 것만 준다 ────────────────────────────────
       ⚠️ 날짜 조건은 **산출물 파일명 앞 토큰**을 본다(경로에 파일명이 들어 있다).
          `%20240315\_%` 처럼 밑줄을 escape 해야 한다 — LIKE 에서 _ 는 한 글자 와일드카드다.
  -->
  <sql id="날짜조건mysql">
    <if test="docDate != null">AND 저장경로내용 LIKE CONCAT('%', #{docDate}, '\_%') ESCAPE '\\'</if>
  </sql>
  <sql id="날짜조건oracle">
    <if test="docDate != null">AND 저장경로내용 LIKE '%' || #{docDate} || '\_%' ESCAPE '\\'</if>
  </sql>
  <sql id="기관조건mysql">
    <if test="institution != null">AND 기관명 LIKE CONCAT('%', #{institution}, '%')</if>
  </sql>
  <sql id="기관조건oracle">
    <if test="institution != null">AND 기관명 LIKE '%' || #{institution} || '%'</if>
  </sql>

  <select id="searchProposals" databaseId="mysql" resultMap="uploadedFileMap">
    SELECT * FROM TSKGIAF01
     WHERE <include refid="처리중"/> AND <include refid="제안서원본"/> AND <include refid="파싱성공"/>
     <include refid="기관조건mysql"/><include refid="날짜조건mysql"/>
     ORDER BY 업로드파일일련번호 DESC
     LIMIT #{limit} OFFSET #{offset}
  </select>
  <select id="searchProposals" databaseId="oracle" resultMap="uploadedFileMap">
    SELECT * FROM (
      SELECT t.*, ROWNUM rnum FROM (
        SELECT * FROM TSKGIAF01
         WHERE <include refid="처리중"/> AND <include refid="제안서원본"/> AND <include refid="파싱성공"/>
         <include refid="기관조건oracle"/><include refid="날짜조건oracle"/>
         ORDER BY 업로드파일일련번호 DESC
      ) t WHERE ROWNUM &lt;= #{offset} + #{limit}
    ) WHERE rnum &gt; #{offset}
  </select>
  <select id="countProposals" databaseId="mysql" resultType="long">
    SELECT COUNT(*) FROM TSKGIAF01
     WHERE <include refid="처리중"/> AND <include refid="제안서원본"/> AND <include refid="파싱성공"/>
     <include refid="기관조건mysql"/><include refid="날짜조건mysql"/>
  </select>
  <select id="countProposals" databaseId="oracle" resultType="long">
    SELECT COUNT(*) FROM TSKGIAF01
     WHERE <include refid="처리중"/> AND <include refid="제안서원본"/> AND <include refid="파싱성공"/>
     <include refid="기관조건oracle"/><include refid="날짜조건oracle"/>
  </select>

  <select id="searchRfps" databaseId="mysql" resultMap="uploadedFileMap">
    SELECT * FROM TSKGIAF01
     WHERE <include refid="처리중"/> AND <include refid="RFP원본"/> AND <include refid="파싱성공"/>
     <include refid="기관조건mysql"/><include refid="날짜조건mysql"/>
     ORDER BY 업로드파일일련번호 DESC
     LIMIT #{limit} OFFSET #{offset}
  </select>
  <select id="searchRfps" databaseId="oracle" resultMap="uploadedFileMap">
    SELECT * FROM (
      SELECT t.*, ROWNUM rnum FROM (
        SELECT * FROM TSKGIAF01
         WHERE <include refid="처리중"/> AND <include refid="RFP원본"/> AND <include refid="파싱성공"/>
         <include refid="기관조건oracle"/><include refid="날짜조건oracle"/>
         ORDER BY 업로드파일일련번호 DESC
      ) t WHERE ROWNUM &lt;= #{offset} + #{limit}
    ) WHERE rnum &gt; #{offset}
  </select>
  <select id="countRfps" databaseId="mysql" resultType="long">
    SELECT COUNT(*) FROM TSKGIAF01
     WHERE <include refid="처리중"/> AND <include refid="RFP원본"/> AND <include refid="파싱성공"/>
     <include refid="기관조건mysql"/><include refid="날짜조건mysql"/>
  </select>
  <select id="countRfps" databaseId="oracle" resultType="long">
    SELECT COUNT(*) FROM TSKGIAF01
     WHERE <include refid="처리중"/> AND <include refid="RFP원본"/> AND <include refid="파싱성공"/>
     <include refid="기관조건oracle"/><include refid="날짜조건oracle"/>
  </select>

